{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "landing-promotor-supletivo-net-br",
  "compatibility_date": "2026-09-16",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist"
  },
  "workers_dev": true,
  "routes": [
    {
      "pattern": "promotor.supletivo.net.br",
      "custom_domain": true
    }
  ]
}
