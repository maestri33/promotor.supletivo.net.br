---
import Base from '../layouts/Base.astro';
import ProgressBar from '../components/ProgressBar.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Steps from '../components/Steps.astro';
import Product from '../components/Product.astro';
import Earnings from '../components/Earnings.astro';
import Path from '../components/Path.astro';
import TestimonialsIsland from '../components/TestimonialsIsland.astro';
import Requirements from '../components/Requirements.astro';
import Trust from '../components/Trust.astro';
import Faq from '../components/Faq.astro';
import FinalCta from '../components/FinalCta.astro';
import StickyCta from '../components/StickyCta.astro';
import BackToTop from '../components/BackToTop.astro';
import FloatingHubAlert from '../components/FloatingHubAlert.astro';
import PromoterLeadCaptureModal from '../components/PromoterLeadCaptureModal.astro';
import Footer from '../components/Footer.astro';
import { faq } from '../data/faq';
import { BRAND, PROGRAM, brl, COMMISSION_DIRECT, LEGAL_NAME, CNPJ, CONTACT_EMAIL } from '../config';

const title = `Seja Promotor ${BRAND} — mude vidas e ganhe por indicação`;
const description =
  `Vire promotor do ${BRAND}: indique o Supletivo Brasil (EJA online para concluir o ensino fundamental ou o médio), ajude alguém a fechar esse ciclo da vida e ganhe ${brl(COMMISSION_DIRECT)} por matrícula paga, mais bônus, no seu Pix toda semana. ` +
  'Renda extra de verdade, grátis pra entrar, sem vender nada. Cadastre-se pelo celular.';

const site = Astro.site!;
const siteUrl = site.href;

// JSON-LD — Organization + WebSite + JobPosting + FAQPage
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${siteUrl}#org`,
      name: `${BRAND} — ${PROGRAM}`,
      legalName: LEGAL_NAME,
      url: siteUrl,
      sameAs: 'https://supletivo.net.br/',
      logo: new URL('/apple-touch-icon.png', site).href,
      taxID: CNPJ,
      address: {
        '@type': 'PostalAddress',
        addressCountry: 'BR',
        addressRegion: 'SP',
        addressLocality: 'São Paulo',
      },
      contactPoint: {
        '@type': 'ContactPoint',
        contactType: 'customer support',
        telephone: '+5542984321915',
        email: CONTACT_EMAIL,
        availableLanguage: ['Portuguese'],
      },
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}#site`,
      name: `${BRAND} · ${PROGRAM}`,
      url: siteUrl,
      inLanguage: 'pt-BR',
      publisher: { '@id': `${siteUrl}#org` },
    },
    {
      '@type': 'JobPosting',
      '@id': `${siteUrl}#vaga`,
      title: 'Promotor de Indicações — Supletivo Brasil (Remoto / Home Office)',
      description:
        '<p>Indique o Supletivo Brasil (Educação de Jovens e Adultos - EJA) pelo celular e ganhe comissão de R$ 100,00 por matrícula paga mais bônus semanal de R$ 500,00 a cada 5 matrículas, depositados toda semana no seu Pix. Atuação 100% remota (Home Office), sem investimento prévio, sem metas obrigatórias e sem vínculo de emprego.</p>',
      identifier: {
        '@type': 'PropertyValue',
        name: BRAND,
        value: 'PROMOTOR-EJA',
      },
      datePosted: '2026-01-01',
      validThrough: '2027-12-31T23:59:59Z',
      employmentType: 'CONTRACTOR',
      hiringOrganization: {
        '@type': 'Organization',
        name: BRAND,
        sameAs: 'https://supletivo.net.br/',
        logo: new URL('/apple-touch-icon.png', site).href,
      },
      jobLocationType: 'TELECOMMUTE',
      applicantLocationRequirements: {
        '@type': 'Country',
        name: 'BR',
      },
      jobLocation: {
        '@type': 'Place',
        address: {
          '@type': 'PostalAddress',
          addressCountry: 'BR',
        },
      },
      baseSalary: {
        '@type': 'MonetaryAmount',
        currency: 'BRL',
        value: {
          '@type': 'QuantitativeValue',
          value: COMMISSION_DIRECT,
          unitText: 'UNIT',
        },
      },
      directApply: true,
      url: siteUrl,
    },
    {
      '@type': 'FAQPage',
      '@id': `${siteUrl}#faq`,
      mainEntity: faq.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: item.a },
      })),
    },
  ],
};
---

<Base {title} {description} {schema}>
  <ProgressBar />
  <Header />
  <main id="conteudo" tabindex="-1">
    <Hero />
    <Steps />
    <Product />
    <Earnings />
    <Path />
    <TestimonialsIsland />
    <Requirements />
    <Trust />
    <Faq />
    <FinalCta />
  </main>
  <FloatingHubAlert />
  <PromoterLeadCaptureModal />
  <Footer />
  <StickyCta />
  <BackToTop />
</Base>
