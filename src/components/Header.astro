---
/**
 * Header sticky institucional com dark glassmorphism e filete de marca Supletivo Brasil.
 * Acompanha a rolagem da página proporcionando navegação rápida, menu mobile e acesso imediato ao CTA.
 * Padrão Editorial "Pátria Amada Refinada" em total conformidade com o DESIGN.md e WCAG AA/AAA.
 */
import Logo from './Logo.astro';
import { CTA_LABEL } from '../config';

const pathname = Astro.url.pathname;
const isHome = pathname === '/' || pathname === '';
const homePrefix = isHome ? '' : '/';
---

<header class="site-header" id="header">
  <div class="header-brand-rule" aria-hidden="true"></div>
  <div class="container site-header-inner">
    <div class="header-logo-wrap">
      <Logo variant="light" />
    </div>

    <!-- Navegação Desktop -->
    <nav class="site-nav" aria-label="Seções da página">
      <a href={`${homePrefix}#como-funciona`}>Como funciona</a>
      <a href={`${homePrefix}#ganhos`}>Ganhos</a>
      <a href={`${homePrefix}#depoimentos`}>Depoimentos</a>
      <a href={`${homePrefix}#caminho`}>Como entrar</a>
      <a href={`${homePrefix}#faq`}>Dúvidas</a>
    </nav>

    <div class="header-action">
      <!-- Link Portal do Aluno (Desktop) -->
      <a
        href="https://supletivo.net.br/"
        target="_blank"
        rel="noopener noreferrer"
        class="header-student-btn"
        aria-label="Ir para o portal do aluno Supletivo Brasil (abre em nova aba)"
      >
        <span class="student-beacon" aria-hidden="true">
          <span class="beacon-pulse"></span>
          <span class="beacon-dot"></span>
        </span>
        <span class="student-btn-text">Portal Aluno ↗</span>
      </a>

      <!-- Botão CTA Principal -->
      <a href={`${homePrefix}#caminho`} class="header-cta" data-cta="header">
        <span class="header-cta-text cta-text-full">{CTA_LABEL}</span>
        <span class="header-cta-text cta-text-short">Ser promotor</span>
        <span class="header-arrow" aria-hidden="true">→</span>
      </a>

      <!-- Botão Hambúrguer Mobile (< 960px) -->
      <button
        type="button"
        class="nav-toggle-btn"
        id="nav-toggle-btn"
        aria-label="Abrir menu de navegação"
        aria-expanded="false"
        aria-controls="mobile-nav-drawer"
      >
        <span class="nav-toggle-box" aria-hidden="true">
          <span class="nav-bar nav-bar--top"></span>
          <span class="nav-bar nav-bar--mid"></span>
          <span class="nav-bar nav-bar--bot"></span>
        </span>
      </button>
    </div>
  </div>

  <!-- Drawer / Gaveta de Navegação Mobile -->
  <div
    id="mobile-nav-drawer"
    class="mobile-nav-drawer"
    aria-hidden="true"
  >
    <div class="mobile-nav-backdrop" data-close-drawer tabindex="-1"></div>
    <div
      class="mobile-nav-dialog"
      role="dialog"
      aria-modal="true"
      aria-label="Menu de navegação Programa de Promotores Supletivo Brasil"
    >
      <div class="mobile-nav-header">
        <Logo variant="light" />
        <button
          type="button"
          class="mobile-nav-close"
          data-close-drawer
          aria-label="Fechar menu de navegação"
        >
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>

      <nav class="mobile-nav-content" aria-label="Navegação mobile promotor">
        <div class="mobile-nav-section">
          <span class="mobile-nav-heading">O Programa</span>
          <ul class="mobile-nav-list">
            <li><a href={`${homePrefix}#como-funciona`} class="mobile-nav-link" data-mobile-link>Como funciona</a></li>
            <li><a href={`${homePrefix}#ganhos`} class="mobile-nav-link" data-mobile-link>Quanto dá pra ganhar</a></li>
            <li><a href={`${homePrefix}#depoimentos`} class="mobile-nav-link" data-mobile-link>Depoimentos</a></li>
            <li><a href={`${homePrefix}#caminho`} class="mobile-nav-link" data-mobile-link>Como entrar</a></li>
            <li><a href={`${homePrefix}#faq`} class="mobile-nav-link" data-mobile-link>Dúvidas Frequentes</a></li>
          </ul>
        </div>

        <div class="mobile-nav-section">
          <span class="mobile-nav-heading">Ecossistema & Cursos</span>
          <ul class="mobile-nav-list mobile-nav-sublist">
            <li><a href="https://supletivo.net.br/" target="_blank" rel="noopener noreferrer" class="mobile-nav-link" data-mobile-link>Portal do Aluno ↗</a></li>
            <li><a href="https://supletivo.net.br/supletivo-online/" target="_blank" rel="noopener noreferrer" class="mobile-nav-link" data-mobile-link>Supletivo Online</a></li>
            <li><a href="https://supletivo.net.br/eja-a-distancia/" target="_blank" rel="noopener noreferrer" class="mobile-nav-link" data-mobile-link>EJA a Distância</a></li>
            <li><a href="https://supletivo.net.br/terminar-ensino-medio/" target="_blank" rel="noopener noreferrer" class="mobile-nav-link" data-mobile-link>Ensino Médio</a></li>
          </ul>
        </div>

        <div class="mobile-nav-footer">
          <div class="mobile-legal-links">
            <a href="/termos/" class="mobile-sublink" data-mobile-link>Termos do Programa</a>
            <span aria-hidden="true">·</span>
            <a href="/privacidade/" class="mobile-sublink" data-mobile-link>Privacidade</a>
          </div>

          <a href={`${homePrefix}#caminho`} class="mobile-nav-cta-btn" data-cta="header_mobile" data-mobile-link>
            <span>{CTA_LABEL}</span>
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </nav>
    </div>
  </div>
</header>

<script>
  function setupMobileNavigation() {
    const toggleBtn = document.getElementById('nav-toggle-btn');
    const drawer = document.getElementById('mobile-nav-drawer');
    if (!toggleBtn || !drawer) return;

    let isOpen = false;

    function openDrawer() {
      isOpen = true;
      drawer.classList.add('is-open');
      drawer.setAttribute('aria-hidden', 'false');
      toggleBtn.setAttribute('aria-expanded', 'true');
      toggleBtn.setAttribute('aria-label', 'Fechar menu de navegação');
      document.documentElement.classList.add('mobile-nav-locked');
      
      const firstFocusable = drawer.querySelector<HTMLElement>('.mobile-nav-close, .mobile-nav-link');
      firstFocusable?.focus();
    }

    function closeDrawer() {
      if (!isOpen) return;
      isOpen = false;
      drawer.classList.remove('is-open');
      drawer.setAttribute('aria-hidden', 'true');
      toggleBtn.setAttribute('aria-expanded', 'false');
      toggleBtn.setAttribute('aria-label', 'Abrir menu de navegação');
      document.documentElement.classList.remove('mobile-nav-locked');
      toggleBtn.focus();
    }

    toggleBtn.addEventListener('click', (e) => {
      e.preventDefault();
      if (isOpen) {
        closeDrawer();
      } else {
        openDrawer();
      }
    });

    drawer.querySelectorAll('[data-close-drawer]').forEach((el) => {
      el.addEventListener('click', () => closeDrawer());
    });

    drawer.querySelectorAll('[data-mobile-link]').forEach((link) => {
      link.addEventListener('click', () => {
        closeDrawer();
      });
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen) {
        closeDrawer();
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupMobileNavigation);
  } else {
    setupMobileNavigation();
  }
  document.addEventListener('astro:page-load', setupMobileNavigation);
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    inset-inline: 0;
    z-index: 50;
    background-color: rgba(11, 18, 32, 0.94);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border-bottom: none;
    box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.5);
    padding-block: 0.75rem;
    padding-top: max(0.75rem, env(safe-area-inset-top));
    transition: background-color 0.25s ease, border-color 0.25s ease;
    max-width: 100vw;
    overflow-x: clip;
  }

  /* Filete gradiente de assinatura de marca na borda inferior */
  .header-brand-rule {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 2px;
    background-image: linear-gradient(
      90deg,
      var(--green) 0%,
      var(--yellow) 50%,
      var(--blue) 100%
    );
    box-shadow: 0 1px 8px -2px var(--green);
    pointer-events: none;
    z-index: 2;
  }

  .site-header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .header-logo-wrap {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 0.2rem;
    margin-inline: auto;
  }

  .site-nav a {
    color: rgba(255, 255, 255, 0.85);
    font-weight: 600;
    font-size: 0.88rem;
    text-decoration: none;
    padding: 0.5rem 0.85rem;
    min-height: 48px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    transition: background-color 0.2s var(--ease-out), color 0.2s ease;
    white-space: nowrap;
  }

  .site-nav a:hover {
    color: #ffffff;
    background-color: rgba(255, 255, 255, 0.1);
  }

  .site-nav a:focus-visible,
  .header-cta:focus-visible,
  .header-student-btn:focus-visible,
  .nav-toggle-btn:focus-visible,
  .mobile-nav-close:focus-visible,
  .mobile-nav-link:focus-visible {
    outline: 2px solid var(--yellow);
    outline-offset: 2px;
  }

  .header-action {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex-shrink: 0;
  }

  /* Link Portal Aluno no Desktop */
  .header-student-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.85rem;
    min-height: 48px;
    border-radius: 999px;
    background: rgba(0, 39, 118, 0.45);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #ffffff;
    font-size: 0.82rem;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    transition: transform 0.2s var(--ease-out), border-color 0.2s ease, background-color 0.2s ease;
  }

  .header-student-btn:hover {
    transform: translateY(-1.5px);
    border-color: var(--yellow);
    background: rgba(0, 39, 118, 0.7);
    color: var(--yellow);
  }

  .student-beacon {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 8px;
    height: 8px;
    flex-shrink: 0;
  }

  .student-beacon .beacon-dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background-color: var(--yellow);
    box-shadow: 0 0 5px var(--yellow);
  }

  .student-beacon .beacon-pulse {
    position: absolute;
    inset: -3px;
    border-radius: 999px;
    background-color: rgba(255, 196, 0, 0.5);
    animation: beacon-ping 2.2s cubic-bezier(0, 0, 0.2, 1) infinite;
  }

  @keyframes beacon-ping {
    0% {
      transform: scale(0.8);
      opacity: 0.95;
    }
    70%, 100% {
      transform: scale(2.2);
      opacity: 0;
    }
  }

  /* Botão CTA Principal */
  .header-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.85rem;
    font-weight: 700;
    padding: 0.5rem 1.15rem;
    min-height: 48px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #ffffff;
    text-decoration: none;
    transition: transform 0.18s var(--ease-out), background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
    white-space: nowrap;
  }

  .header-cta:hover {
    background: rgba(255, 196, 0, 0.15);
    border-color: var(--yellow);
    color: var(--yellow);
    transform: translateY(-1px);
  }

  .header-arrow {
    transition: transform 0.18s var(--ease-out);
  }

  .header-cta:hover .header-arrow {
    transform: translateX(2px);
  }

  /* Botão Toggle Hambúrguer Mobile */
  .nav-toggle-btn {
    display: none;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    min-width: 44px;
    min-height: 44px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.18);
    color: #ffffff;
    cursor: pointer;
    padding: 0;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .nav-toggle-btn:hover {
    background: rgba(255, 255, 255, 0.14);
    border-color: var(--yellow);
  }

  .nav-toggle-box {
    position: relative;
    width: 20px;
    height: 14px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .nav-bar {
    display: block;
    width: 100%;
    height: 2px;
    background-color: #ffffff;
    border-radius: 2px;
    transition: transform 0.25s ease, opacity 0.2s ease;
  }

  .site-header:has(.mobile-nav-drawer.is-open) .nav-bar--top {
    transform: translateY(6px) rotate(45deg);
  }

  .site-header:has(.mobile-nav-drawer.is-open) .nav-bar--mid {
    opacity: 0;
  }

  .site-header:has(.mobile-nav-drawer.is-open) .nav-bar--bot {
    transform: translateY(-6px) rotate(-45deg);
  }

  /* Drawer Mobile (Sheet) */
  .mobile-nav-drawer {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    justify-content: flex-end;
    visibility: hidden;
    pointer-events: none;
    transition: visibility 0.28s ease;
  }

  .mobile-nav-drawer.is-open {
    visibility: visible;
    pointer-events: auto;
  }

  .mobile-nav-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(11, 18, 32, 0.75);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    opacity: 0;
    transition: opacity 0.28s ease;
  }

  .mobile-nav-drawer.is-open .mobile-nav-backdrop {
    opacity: 1;
  }

  .mobile-nav-dialog {
    position: relative;
    width: min(85vw, 360px);
    height: 100%;
    background: #0b1220;
    border-left: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: -10px 0 30px rgba(0, 0, 0, 0.6);
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1);
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    padding-bottom: max(1.5rem, env(safe-area-inset-bottom));
  }

  .mobile-nav-drawer.is-open .mobile-nav-dialog {
    transform: translateX(0);
  }

  .mobile-nav-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.2rem 1.4rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .mobile-nav-close {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    min-width: 38px;
    min-height: 38px;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: #ffffff;
    cursor: pointer;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .mobile-nav-close:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: var(--yellow);
  }

  .mobile-nav-content {
    display: flex;
    flex-direction: column;
    padding: 1.2rem 1.4rem;
    gap: 1.4rem;
  }

  .mobile-nav-section {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .mobile-nav-heading {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted-on-dark);
    margin-bottom: 0.2rem;
  }

  .mobile-nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .mobile-nav-link {
    color: #ffffff;
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 0.4rem 0.6rem;
    border-radius: 8px;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .mobile-nav-link:hover {
    background: rgba(255, 255, 255, 0.08);
    color: var(--yellow);
  }

  .mobile-nav-sublist .mobile-nav-link {
    font-size: 0.92rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.85);
  }

  .mobile-nav-footer {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    margin-top: 0.6rem;
    padding-top: 1.2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .mobile-legal-links {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    font-size: 0.8rem;
    color: var(--muted-on-dark);
  }

  .mobile-sublink {
    color: var(--muted-on-dark);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .mobile-sublink:hover {
    color: var(--yellow);
    text-decoration: underline;
  }

  .mobile-nav-cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    min-height: 48px;
    padding: 0.65rem 1.25rem;
    border-radius: 999px;
    background-color: var(--yellow);
    color: var(--ink);
    font-weight: 800;
    font-size: 0.95rem;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    box-shadow: 0 4px 14px rgba(255, 196, 0, 0.35);
  }

  .mobile-nav-cta-btn:hover {
    transform: translateY(-1.5px);
    box-shadow: 0 6px 20px rgba(255, 196, 0, 0.45);
  }

  .cta-text-short {
    display: none;
  }

  /* Adaptações Responsivas */
  @media (max-width: 959px) {
    .site-nav {
      display: none;
    }
    .header-action {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      margin-left: auto;
    }
    .nav-toggle-btn {
      display: inline-flex;
    }
  }

  @media (max-width: 640px) {
    .site-header {
      padding-block: 0.45rem;
    }
    .header-student-btn {
      display: none;
    }
    .cta-text-full {
      display: none;
    }
    .cta-text-short {
      display: inline;
    }
    .header-cta {
      font-size: 0.8rem;
      padding: 0.35rem 0.75rem;
      min-height: 40px;
    }
  }

  @media (max-width: 380px) {
    .header-cta .header-arrow {
      display: none;
    }
    .header-cta {
      font-size: 0.75rem;
      padding: 0.3rem 0.6rem;
      min-height: 36px;
    }
  }
</style>
