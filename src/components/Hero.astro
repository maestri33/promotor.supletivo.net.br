---
/**
 * Seção 1 — O gancho (ganha-ganha).
 * "Mude vidas." vazado (o propósito) → "Ganhe também." sólido com swoosh (a renda).
 * Glow + grain + chips + marquee + celular mostrando o ciclo (link → Pix).
 * Tudo CSS; roda sem JS; some em reduced-motion.
 */
import CtaButton from './CtaButton.astro';
import PixPhone from './PixPhone.astro';
import Marquee from './Marquee.astro';
import { brl, COMMISSION_DIRECT, PRODUCT_NAME, BRAND } from '../config';

const LINE_1 = 'Mude vidas.';
const LINE_2 = 'Ganhe também.';
const chips = ['Você muda uma vida', 'E ganha por isso', 'Tudo pelo celular'];
const valor = brl(COMMISSION_DIRECT);
---

<section id="hero" class="hero on-dark grain" aria-labelledby="hero-title" data-section="hero">
  <div class="hero-decor" aria-hidden="true">
    <span class="blob blob-1"></span>
    <span class="blob blob-2"></span>
    <svg class="hero-diamonds" viewBox="0 0 900 900" fill="none">
      <g stroke="#ffffff" stroke-opacity="0.05" stroke-width="2">
        <path d="M450 50 850 450 450 850 50 450Z"></path>
        <path d="M450 140 760 450 450 760 140 450Z"></path>
        <path d="M450 230 670 450 450 670 230 450Z"></path>
      </g>
      <path
        d="M450 320 580 450 450 580 320 450Z"
        stroke="var(--yellow)"
        stroke-opacity="0.3"
        stroke-width="3"></path>
      <path
        d="M408 452l34 34 78-78"
        stroke="var(--yellow)"
        stroke-opacity="0.45"
        stroke-width="7"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </div>

  <div class="hero-phone">
    <PixPhone />
  </div>

  <div class="container hero-inner">
    <div class="hero-top-row anim-up" style="--i: 0">
      <p class="hero-eyebrow">
        <span class="dot pulse-live-dot" aria-hidden="true"></span>
        Programa de Promotores · {BRAND}
      </p>
      <span class="badge-pill-gold">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/></svg>
        Credenciamento Oficial
      </span>
      <span class="badge-pill-gold hidden" data-hub-badge>
        <span class="hub-pill-dot" aria-hidden="true"></span>
        Polo: <strong data-hub-badge-text>Regional</strong>
      </span>
    </div>

    <h1 id="hero-title" class="hero-title">
      <span class="hero-line hero-line--ghost">
        <span class="w ghost" style="--i: 1">{LINE_1}</span>
      </span>
      <span class="hero-line">
        <span class="w w-accent" style="--i: 2">
          {LINE_2}
          <svg class="swoosh" aria-hidden="true" viewBox="0 0 220 24" fill="none" preserveAspectRatio="none">
            <path
              d="M4 17 C60 8, 150 6, 216 12"
              stroke="var(--yellow)"
              stroke-width="7"
              stroke-linecap="round"
              pathLength="1"></path>
          </svg>
        </span>
      </span>
    </h1>

    <p class="hero-sub anim-up" style="--i: 3">
      Ajudar alguém a <strong>concluir os estudos</strong> já muda uma vida.
      Agora imagina fazer isso <strong>e ainda receber por isso</strong> — toda
      semana, no seu Pix. Você só indica o {PRODUCT_NAME} pelo celular. Sem
      estoque, sem vender nada.
    </p>

    <ul class="hero-chips anim-up" style="--i: 4">
      {chips.map((chip, i) => (
        <li class="chip" style={`--f: ${i}`}>
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path
              d="M5 12.5l4.5 4.5L19 7.5"
              stroke="currentColor"
              stroke-width="3"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
          {chip}
        </li>
      ))}
    </ul>

    <div class="hero-cta anim-up" style="--i: 5">
      <CtaButton position="hero" class="btn-xl" />
      <p class="microcopy">
        <strong><span data-promoter-commission-val>{valor}</span> por matrícula paga</strong> · você recebe por Pix toda semana
      </p>
      <p class="hero-time">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2"></circle>
          <path d="M12 7v5l3 2" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
        </svg>
        <span>Cadastro em <strong>1 minuto</strong> pelo celular · sem senha · 100% grátis</span>
      </p>
    </div>
  </div>

  <a class="scroll-cue" href="#como-funciona" aria-label="Rolar para a próxima seção">
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path
        d="M6 9.5l6 6 6-6"
        stroke="currentColor"
        stroke-width="2.4"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </a>

  <div class="hero-marquee">
    <Marquee
      items={['Ajude alguém a se formar', 'Receba por Pix', 'Sem vender nada', 'Grátis pra entrar', 'Mude uma vida', 'E ganhe por isso']}
      variant="yellow"
      speed={30}
    />
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    /* topo respeita notch/Dynamic Island (viewport-fit=cover no Base) */
    padding-top: max(clamp(4.5rem, 10vh, 9rem), calc(env(safe-area-inset-top) + 4.5rem));
    padding-bottom: 0;
    background:
      radial-gradient(58rem 32rem at 18% 4%, rgb(255 196 0 / 0.1), transparent 62%),
      linear-gradient(168deg, var(--blue) 0%, var(--blue-deep) 55%, var(--ink) 100%);
    color: var(--paper);
    overflow: clip;
  }

  .hero-decor {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(70px);
  }

  .blob-1 {
    width: 34rem;
    height: 34rem;
    left: -12rem;
    top: -10rem;
    background: rgb(255 196 0 / 0.14);
  }

  .blob-2 {
    width: 28rem;
    height: 28rem;
    right: -10rem;
    bottom: -6rem;
    background: rgb(0 115 77 / 0.35);
  }

  @media (prefers-reduced-motion: no-preference) {
    .blob-1 {
      animation: blob-drift 16s ease-in-out infinite alternate;
    }

    .blob-2 {
      animation: blob-drift 19s ease-in-out infinite alternate-reverse;
    }
  }

  @keyframes blob-drift {
    to {
      transform: translate(3rem, 2rem) scale(1.08);
    }
  }

  .hero-diamonds {
    position: absolute;
    width: min(120vmin, 56rem);
    height: auto;
    right: -18%;
    top: 50%;
    translate: 0 -50%;
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .hero-diamonds {
        animation: diamond-spin linear both;
        animation-timeline: view(block 0%);
      }
    }
  }

  @keyframes diamond-spin {
    to {
      transform: translateY(-12rem) rotate(14deg);
    }
  }

  @media (max-width: 720px) {
    .hero-diamonds {
      width: 150vmin;
      right: -65%;
    }
  }

  /* celular: mobile é o canal principal — entra no fluxo, logo depois do CTA;
     no desktop vira a peça absoluta da direita com suporte a tilt 3D */
  .hero-phone {
    order: 2;
    width: min(64vw, 248px);
    margin: 2.8rem auto 0;
    position: relative;
    z-index: 2;
  }

  .hero-inner {
    order: 1;
    position: relative;
    padding-bottom: clamp(5rem, 11vh, 7rem);
  }

  @media (min-width: 960px) {
    .hero-phone {
      position: absolute;
      right: clamp(0rem, 3vw, 5rem);
      top: 50%;
      translate: 0 -50%;
      width: min(30vw, 320px);
      margin: 0;
      z-index: 2;
    }

    .hero-diamonds {
      display: none;
    }

    .hero-inner {
      padding-right: min(34vw, 420px);
    }
  }

  .hero-top-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.8rem;
  }

  .hub-pill-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--yellow);
    box-shadow: 0 0 6px var(--yellow);
    display: inline-block;
    margin-right: 0.25rem;
  }

  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--yellow);
    border: 1px solid rgb(255 196 0 / 0.4);
    border-radius: 999px;
    padding: 0.45em 1.1em;
    margin-bottom: 0;
    background: rgb(255 196 0 / 0.06);
  }

  .hero-eyebrow .dot {
    width: 0.5em;
    height: 0.5em;
    border-radius: 50%;
    background: var(--green);
    flex: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-eyebrow .dot {
      animation: dot-pulse 2.2s ease-in-out infinite;
    }
  }

  @keyframes dot-pulse {
    50% {
      transform: scale(1.6);
      opacity: 0.55;
    }
  }

  .hero-title {
    font-size: var(--text-hero);
    max-width: 12ch;
    letter-spacing: -0.015em;
  }

  .hero-line {
    display: block;
  }

  .hero-line--ghost {
    opacity: 0.95;
  }

  .w {
    display: inline-block;
  }

  .w-accent {
    position: relative;
    color: var(--yellow);
    display: inline-block;
  }

  .swoosh {
    position: absolute;
    left: -2%;
    right: -4%;
    bottom: -0.18em;
    width: 104%;
    height: 0.22em;
  }

  .swoosh path {
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .swoosh path {
      stroke-dashoffset: 1;
      animation: swoosh-draw 0.55s var(--ease-out) 1.1s forwards;
    }
  }

  @keyframes swoosh-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  .hero-sub {
    font-size: var(--text-lg);
    color: var(--muted-on-dark);
    max-width: 34ch;
    margin-top: 1.6rem;
  }

  .hero-sub strong {
    color: var(--paper);
  }

  .hero-chips {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    padding: 0;
    margin: 1.6rem 0 0;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--paper);
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 999px;
    padding: 0.45em 1.1em;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 8px 20px -6px rgba(0, 0, 0, 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.15);
    transition: transform 0.25s var(--ease-antigravity), border-color 0.25s var(--ease-out), box-shadow 0.25s var(--ease-out);
  }

  .chip:hover {
    transform: translateY(-3px) scale(1.03);
    border-color: rgba(255, 196, 0, 0.45);
    box-shadow: 0 12px 28px -6px rgba(255, 196, 0, 0.2), inset 0 1px 0 rgba(255, 255, 255, 0.25);
  }

  .chip svg {
    width: 0.95em;
    height: 0.95em;
    color: var(--yellow);
  }

  @media (prefers-reduced-motion: no-preference) {
    .chip {
      animation: chip-float 6.5s ease-in-out infinite;
      animation-delay: calc(var(--f) * 1.1s);
    }
  }

  @keyframes chip-float {
    50% {
      transform: translateY(-7px);
    }
  }

  .hero-cta {
    margin-top: 2.4rem;
  }

  .hero .microcopy {
    color: var(--muted-on-dark);
  }

  .hero .microcopy strong {
    color: var(--yellow);
  }

  .hero-time {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin-top: 0.6rem;
    padding: 0.5em 1em;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.05);
    font-size: 0.84rem;
    color: var(--muted-on-dark);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.1);
  }

  .hero-time strong {
    color: var(--paper);
    font-weight: 700;
  }

  .hero-time svg {
    width: 1em;
    height: 1em;
    color: var(--yellow);
    flex: none;
  }

  .scroll-cue {
    position: absolute;
    bottom: 4rem;
    left: 50%;
    transform: translateX(-50%);
    width: 3rem;
    height: 3rem;
    display: grid;
    place-items: center;
    color: var(--paper);
    opacity: 0.65;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 50%;
    transition: opacity 0.2s var(--ease-out), transform 0.2s var(--ease-out), border-color 0.2s var(--ease-out);
    z-index: 3;
  }

  .scroll-cue:hover {
    opacity: 1;
    border-color: var(--yellow);
    transform: translateX(-50%) translateY(3px);
    color: var(--yellow);
  }

  .scroll-cue svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  @media (max-width: 959px) {
    .scroll-cue {
      display: none;
    }
  }

  .hero-marquee {
    position: relative;
    z-index: 3;
    margin-top: auto;
  }

  /* Entrada sequencial de cima para baixo */
  .anim-up {
    animation: hero-fade-up 0.8s var(--ease-out) calc(var(--i) * 0.1s + 0.15s) backwards;
  }

  @keyframes hero-fade-up {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .anim-up {
      animation: none;
    }
  }
</style>
