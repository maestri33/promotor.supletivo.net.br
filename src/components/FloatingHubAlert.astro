---
/**
 * Alerta flutuante de Vínculo de Polo Regional (?hub= / ?ref=).
 * Alinhado estritamente ao Design System Dark Luxury / Antigravity do Promotor.
 * Informa de maneira elegante que o candidato está associado a um Polo / Regional.
 * Respeita Safe Area Inset mobile, Touch Target 48px e fecha via sessionStorage.
 */
import { BRAND, PROGRAM } from '../config';
---

<aside
  id="floating-hub-alert"
  class="floating-hub-alert hidden"
  data-floating-hub
  aria-live="polite"
  role="status"
>
  <div class="hub-alert-card">
    <div class="hub-alert-header">
      <div class="hub-alert-pill">
        <span class="pulse-dot" aria-hidden="true"></span>
        <span class="hub-alert-pill-text">Vínculo de Polo Ativado</span>
      </div>
      <button
        type="button"
        class="hub-alert-close"
        data-close-hub-alert
        aria-label="Fechar aviso de polo"
        title="Dispensar aviso"
      >
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <div class="hub-alert-body">
      <div class="hub-alert-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
          <circle cx="9" cy="7" r="4"></circle>
          <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
          <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
        </svg>
      </div>

      <div class="hub-alert-content">
        <p class="hub-alert-headline">
          Suporte Regional: Polo <strong class="hub-highlight" data-hub-name>Ativado</strong>
        </p>
        <p class="hub-alert-sub">
          Seu cadastro será vinculado ao polo parceiro oficial do {BRAND}.
        </p>
      </div>
    </div>

    <div class="hub-alert-footer">
      <a href="#ganhos" class="hub-alert-cta" data-cta="floating-hub-alert" aria-label="Ver simulação de ganhos">
        <span>Conhecer ganhos</span>
        <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="7 13 12 18 17 13"></polyline>
          <line x1="12" y1="6" x2="12" y2="18"></line>
        </svg>
      </a>
      <span class="hub-alert-micro">Programa Oficial · {BRAND} {PROGRAM}</span>
    </div>
  </div>
</aside>

<style>
  .floating-hub-alert {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    z-index: 55;
    width: min(92vw, 390px);
    pointer-events: auto;
  }

  .floating-hub-alert.hidden {
    display: none !important;
  }

  .floating-hub-alert.hidden-by-section,
  .floating-hub-alert.hidden-by-hero {
    opacity: 0 !important;
    pointer-events: none !important;
    transform: translateY(16px) scale(0.96) !important;
    transition: opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1), transform 0.3s cubic-bezier(0.16, 1, 0.3, 1) !important;
  }

  .floating-hub-alert.is-visible {
    display: block;
    animation: hubAlertSlideIn 0.45s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .hub-alert-card {
    position: relative;
    padding: 1rem 1.15rem;
    border-radius: 20px;
    background: rgba(14, 14, 17, 0.92);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border: 1.5px solid rgba(217, 177, 90, 0.45);
    box-shadow:
      0 18px 40px -12px rgba(0, 0, 0, 0.8),
      0 0 24px -6px rgba(217, 177, 90, 0.22),
      inset 0 1px 0 rgba(255, 255, 255, 0.18);
    color: #ffffff;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .hub-alert-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .hub-alert-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.22rem 0.65rem;
    border-radius: 9999px;
    background: rgba(217, 177, 90, 0.12);
    border: 1px solid rgba(217, 177, 90, 0.3);
  }

  .pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--gold, #d9b15a);
    box-shadow: 0 0 8px var(--gold, #d9b15a);
    animation: dotPulse 1.8s infinite ease-in-out;
  }

  @keyframes dotPulse {
    0%, 100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.35;
      transform: scale(0.8);
    }
  }

  .hub-alert-pill-text {
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--gold, #d9b15a);
  }

  .hub-alert-close {
    width: 48px;
    height: 48px;
    min-width: 48px;
    min-height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: var(--muted-on-dark, #b4b4bb);
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease, transform 0.15s ease;
    flex-shrink: 0;
  }

  .hub-alert-close:hover {
    background: rgba(255, 255, 255, 0.14);
    color: #ffffff;
    transform: scale(1.05);
  }

  .hub-alert-body {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .hub-alert-icon {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: linear-gradient(135deg, var(--gold, #d9b15a), var(--gold-deep, #a87b2e));
    color: var(--ink, #0b0b0c);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    box-shadow: 0 4px 12px rgba(217, 177, 90, 0.35);
  }

  .hub-alert-content {
    flex: 1;
    min-width: 0;
  }

  .hub-alert-headline {
    margin: 0;
    font-size: 0.88rem;
    font-weight: 700;
    color: #ffffff;
    line-height: 1.25;
  }

  .hub-highlight {
    color: var(--gold, #d9b15a);
    font-weight: 800;
  }

  .hub-alert-sub {
    margin: 0.15rem 0 0 0;
    font-size: 0.76rem;
    color: var(--muted-on-dark, #b4b4bb);
    line-height: 1.3;
  }

  .hub-alert-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    padding-top: 0.4rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .hub-alert-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 48px;
    padding: 0.5rem 1.1rem;
    border-radius: 9999px;
    background: var(--gold, #d9b15a);
    color: var(--ink, #0b0b0c);
    font-size: 0.82rem;
    font-weight: 800;
    text-decoration: none;
    transition: transform 0.18s var(--ease-out), filter 0.18s var(--ease-out);
    white-space: nowrap;
    box-shadow: 0 2px 8px rgba(217, 177, 90, 0.3);
  }

  .hub-alert-cta:hover {
    transform: translateY(-1px);
    filter: brightness(1.06);
  }

  .hub-alert-micro {
    font-size: 0.68rem;
    color: var(--muted-on-dark, #b4b4bb);
    opacity: 0.8;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @keyframes hubAlertSlideIn {
    from {
      opacity: 0;
      transform: translateY(24px) scale(0.95);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  /* Ajustes responsivos para tablets e mobile */
  @media (max-width: 899px) {
    .floating-hub-alert {
      right: 0.75rem;
      left: 0.75rem;
      bottom: calc(4.8rem + env(safe-area-inset-bottom, 0px));
      width: calc(100vw - 1.5rem);
      max-width: none;
    }

    .hub-alert-card {
      padding: 0.85rem 1rem;
      gap: 0.5rem;
    }

    .hub-alert-micro {
      display: none;
    }

    .hub-alert-footer {
      justify-content: flex-end;
      padding-top: 0.2rem;
      border-top: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .floating-hub-alert.is-visible {
      animation: none !important;
    }
    .pulse-dot {
      animation: none !important;
    }
  }
</style>
