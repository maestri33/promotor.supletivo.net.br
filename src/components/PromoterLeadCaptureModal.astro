---
/**
 * PromoterLeadCaptureModal.astro
 * Motor de Captura Inteligente de Promotores (Zero-Friction Promoter Onboarding).
 * Sofia Orientadora de Expansão, validação Módulo 11 e The Promoter Credential Stage.
 * Componentizado e otimizado com mindset Ponytail.
 */
import { APP_URL, BACKEND_URL } from '../config';
import PromoterSofiaPresence from './PromoterSofiaPresence.astro';
import PromoterCredentialCard from './PromoterCredentialCard.astro';
---

<div
  id="promoter-capture-modal"
  class="promoter-modal-backdrop"
  role="dialog"
  aria-modal="true"
  aria-labelledby="promoter-modal-title"
  aria-hidden="true"
  hidden
  inert
  data-promoter-capture-modal
  data-app-url={APP_URL}
  data-backend-url={BACKEND_URL}
>
  <div class="promoter-modal-overlay" data-close-modal></div>

  <div class="promoter-modal-container glass-panel">
    <!-- Drag Handle tátil mobile -->
    <div class="drag-handle-bar md:hidden" aria-hidden="true">
      <div class="drag-pill"></div>
    </div>

    <!-- Botão de Fechar com alvo >= 48px -->
    <button
      type="button"
      class="close-btn"
      aria-label="Fechar janela de cadastro de promotor"
      data-close-modal
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <div class="promoter-modal-layout">
      <!-- Coluna Principal: Sofia + Omnibar + Etapas -->
      <div class="interaction-col">
        <PromoterSofiaPresence />

        <!-- Breadcrumbs Vivos ("Desfazer sem resetar") -->
        <div id="promoter-breadcrumbs" class="promoter-breadcrumbs hidden" aria-label="Progresso do formulário">
          <button type="button" class="pill-chip" id="chip-phone" title="Clique para editar o WhatsApp" aria-label="Voltar para editar WhatsApp">
            <span class="chip-icon">💬</span>
            <span class="chip-label" id="chip-phone-text">(11) 98765-4321</span>
            <span class="chip-edit">✏️</span>
          </button>
          <button type="button" class="pill-chip hidden" id="chip-cpf" title="Clique para editar o CPF" aria-label="Voltar para editar CPF">
            <span class="chip-icon">🪪</span>
            <span class="chip-label" id="chip-cpf-text">000.000.000-00</span>
            <span class="chip-edit">✏️</span>
          </button>
        </div>

        <!-- Formulário Dinâmico Omnibar Zero-Button -->
        <form id="promoter-capture-form" class="omnibar-form" novalidate>
          <!-- ETAPA 1: WHATSAPP -->
          <div id="step-phone" class="step-pane active">
            <div class="input-wrapper" id="phone-wrapper">
              <span class="input-icon whatsapp-icon" aria-hidden="true">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                  <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
                </svg>
              </span>
              <input
                type="tel"
                id="promoter-input-phone"
                class="omnibar-input"
                placeholder="(DD) 9XXXX-XXXX"
                inputmode="numeric"
                autocomplete="tel-national"
                maxlength="15"
                required
                aria-label="Número do seu WhatsApp para recebimento de comissões"
              />
              <span class="input-status-icon" id="phone-check-icon" aria-hidden="true">
                <svg class="check-svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--success)" stroke-width="3">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <span class="spinner" id="phone-spinner" aria-hidden="true"></span>
              </span>
            </div>
            <p class="input-hint" id="phone-hint">
              Digite seu WhatsApp com DDD. Avanço e checagem imediatos ao completar 11 dígitos.
            </p>
          </div>

          <!-- ETAPA 2: CPF (MÓDULO 11) -->
          <div id="step-cpf" class="step-pane hidden">
            <div class="input-wrapper" id="cpf-wrapper">
              <span class="input-icon" aria-hidden="true">🪪</span>
              <input
                type="tel"
                id="promoter-input-cpf"
                class="omnibar-input"
                placeholder="000.000.000-00"
                inputmode="numeric"
                autocomplete="off"
                maxlength="14"
                aria-label="Número do seu CPF para cadastro da chave Pix"
              />
              <span class="input-status-icon" id="cpf-check-icon" aria-hidden="true">
                <svg class="check-svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--success)" stroke-width="3">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <span class="spinner" id="cpf-spinner" aria-hidden="true"></span>
              </span>
            </div>
            <p class="input-hint" id="cpf-hint">
              Necessário para emissão do contrato. Chave Pix padrão vinculada ao seu CPF (pode ser ajustada no painel).
            </p>
          </div>

          <!-- ETAPA 3: E-MAIL (AUTO-DISPATCH) -->
          <div id="step-email" class="step-pane hidden">
            <div class="input-wrapper" id="email-wrapper">
              <span class="input-icon" aria-hidden="true">✉️</span>
              <input
                type="email"
                id="promoter-input-email"
                class="omnibar-input"
                placeholder="seu@email.com"
                inputmode="email"
                autocomplete="email"
                aria-label="Seu melhor endereço de e-mail profissional"
              />
              <span class="input-status-icon" id="email-check-icon" aria-hidden="true">
                <svg class="check-svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--success)" stroke-width="3">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <span class="spinner" id="promoter-spinner" aria-hidden="true"></span>
              </span>
            </div>
            <p class="input-hint" id="email-hint">
              Para onde enviamos o contrato de comissões e as credenciais de acesso.
            </p>
            <div class="email-domain-chips" id="email-domain-chips" aria-label="Provedores rápidos de e-mail">
              <button type="button" class="domain-chip" data-domain="gmail.com">@gmail.com</button>
              <button type="button" class="domain-chip" data-domain="hotmail.com">@hotmail.com</button>
              <button type="button" class="domain-chip" data-domain="outlook.com">@outlook.com</button>
              <button type="button" class="domain-chip" data-domain="yahoo.com.br">@yahoo.com.br</button>
            </div>
          </div>

          <!-- ESTADO: CADASTRO JÁ LOCALIZADO (AUTO-REDIRECT ZERO-BUTTON) -->
          <div id="step-existing" class="step-pane hidden">
            <div class="existing-user-card">
              <div class="existing-badge">
                <span class="star-icon">★</span>
                Promotor Já Cadastrado
              </div>
              <p class="existing-text">
                Localizamos sua conta de promotor vinculada ao celular com final
                <strong id="existing-phone-masked">(XX) •••••-XXXX</strong>.
              </p>
              <p class="existing-sub">
                Enviamos um código de acesso seguro de 6 dígitos no seu WhatsApp. Redirecionando para login...
              </p>
              <div class="existing-progress-wrap" aria-hidden="true">
                <div class="existing-progress-bar" id="existing-progress-bar"></div>
              </div>
              <p class="existing-redirect-info">
                Redirecionamento automático em <span id="existing-countdown">3</span>s
                · <a href={APP_URL} class="existing-inline-link" id="btn-existing-redirect">Acessar agora &rarr;</a>
              </p>
            </div>
          </div>
        </form>

        <div class="security-footer">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--gold)" stroke-width="2.2">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
          <span>Canal de Afiliados Oficiais · Pagamentos Semanais via Pix toda Sexta às 18h</span>
        </div>
      </div>

      <!-- Coluna Visual: The Promoter Credential Stage (3D Dark Luxury) -->
      <div class="visual-col hidden md:flex">
        <PromoterCredentialCard />
      </div>
    </div>
  </div>
</div>

<style>
  #promoter-breadcrumbs.hidden,
  .spinner.hidden,
  .step-pane.hidden,
  .pill-chip.hidden {
    display: none;
  }

  .promoter-modal-backdrop {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(1rem, 3vw, 2.5rem);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.28s var(--ease-out, cubic-bezier(0.16, 1, 0.3, 1));
  }

  .promoter-modal-backdrop.is-active {
    opacity: 1;
    pointer-events: auto;
  }

  .promoter-modal-overlay {
    position: absolute;
    inset: 0;
    background: rgba(11, 11, 12, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .promoter-modal-container {
    position: relative;
    z-index: 10;
    width: 100%;
    max-width: 58rem;
    background: var(--char, #141416);
    border: 1px solid color-mix(in srgb, var(--gold) 28%, transparent);
    border-radius: var(--radius-lg, 24px);
    box-shadow: 0 28px 64px -12px rgba(0, 0, 0, 0.8), 0 0 32px -4px color-mix(in srgb, var(--gold) 18%, transparent);
    overflow: hidden;
    transform: scale(0.96) translateY(12px);
    transition: transform 0.28s var(--ease-out, cubic-bezier(0.16, 1, 0.3, 1));
  }

  .promoter-modal-backdrop.is-active .promoter-modal-container {
    transform: scale(1) translateY(0);
  }

  .drag-handle-bar {
    display: flex;
    justify-content: center;
    padding-top: 0.75rem;
    padding-bottom: 0.25rem;
  }

  .drag-pill {
    width: 40px;
    height: 4px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.2);
  }

  .close-btn {
    position: absolute;
    top: 1rem;
    right: 1rem;
    z-index: 20;
    width: 48px;
    height: 48px;
    min-width: 48px;
    min-height: 48px;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: var(--muted-on-dark);
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease, transform 0.15s ease;
  }

  .close-btn:hover {
    background: color-mix(in srgb, var(--gold) 15%, transparent);
    color: var(--gold);
    border-color: color-mix(in srgb, var(--gold) 40%, transparent);
    transform: scale(1.05);
  }

  .promoter-modal-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    padding: clamp(1.5rem, 4vw, 2.75rem);
  }

  @media (min-width: 768px) {
    .promoter-modal-layout {
      grid-template-columns: 1.15fr 0.85fr;
      align-items: center;
    }
  }

  .interaction-col {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .promoter-breadcrumbs,
  .email-domain-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .pill-chip,
  .domain-chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    min-height: 48px;
    padding: 0.45rem 0.95rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid color-mix(in srgb, var(--gold) 30%, transparent);
    color: var(--gold-soft);
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }

  .pill-chip:hover,
  .domain-chip:hover {
    background: color-mix(in srgb, var(--gold) 18%, transparent);
    border-color: var(--gold);
    color: var(--paper);
  }

  .omnibar-form {
    width: 100%;
  }

  .step-pane {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .input-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
    min-height: 56px;
    background: rgba(11, 11, 12, 0.8);
    border: 1.5px solid rgba(255, 255, 255, 0.14);
    border-radius: var(--radius, 16px);
    padding: 0 1rem;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .input-wrapper:focus-within {
    border-color: var(--gold);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--gold) 22%, transparent);
  }

  .input-wrapper.valid {
    border-color: var(--success);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--success) 20%, transparent);
  }

  .input-icon {
    font-size: 1.25rem;
    margin-right: 0.75rem;
    color: var(--gold);
    display: flex;
    align-items: center;
  }

  .omnibar-input {
    width: 100%;
    height: 100%;
    min-height: 54px;
    background: transparent;
    border: none;
    outline: none;
    color: var(--paper);
    font-size: 1.15rem;
    font-weight: 600;
    font-family: var(--font-body, 'Inter', sans-serif);
  }

  .omnibar-input::placeholder {
    color: rgba(255, 255, 255, 0.3);
    font-weight: 400;
  }

  .input-status-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-left: 0.5rem;
    position: relative;
    width: 20px;
    height: 20px;
  }

  .input-status-icon .check-svg,
  .input-status-icon .spinner {
    display: none;
  }

  .input-wrapper.loading .input-status-icon .spinner {
    display: inline-block;
  }

  .input-wrapper.loading .input-status-icon .check-svg {
    display: none;
  }

  .input-wrapper.valid:not(.loading) .input-status-icon .check-svg {
    display: inline-block;
  }

  .input-hint {
    font-size: 0.82rem;
    color: var(--muted-on-dark);
    margin: 0;
    padding-left: 0.25rem;
  }

  /* Cartão de promotor já existente */
  .existing-user-card {
    background: color-mix(in srgb, var(--gold) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--gold) 35%, transparent);
    border-radius: var(--radius, 16px);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    text-align: center;
  }

  .existing-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    color: var(--gold);
    font-weight: 700;
    font-size: 0.82rem;
    text-transform: uppercase;
  }

  .existing-text {
    color: var(--paper);
    font-size: 0.95rem;
    line-height: 1.4;
    margin: 0;
  }

  .existing-sub {
    color: var(--muted-on-dark);
    font-size: 0.84rem;
    margin: 0;
  }

  .existing-progress-wrap {
    width: 100%;
    height: 5px;
    background: rgba(255, 255, 255, 0.12);
    border-radius: 999px;
    overflow: hidden;
    margin: 0.5rem 0;
  }

  .existing-progress-bar {
    width: 100%;
    height: 100%;
    background: var(--gold-grad);
    transform-origin: left;
    transform: scaleX(1);
    transition: transform 2.8s linear;
  }

  .existing-redirect-info {
    font-size: 0.78rem;
    color: var(--muted-on-dark);
    margin: 0;
  }

  .existing-inline-link {
    color: var(--gold);
    text-decoration: underline;
    font-weight: 700;
    transition: color 0.15s;
  }

  .existing-inline-link:hover {
    color: var(--paper);
  }

  .security-footer {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--muted-on-dark);
    font-size: 0.76rem;
    padding-top: 0.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  /* Spinner */
  .spinner {
    width: 1.1rem;
    height: 1.1rem;
    border: 2px solid rgba(255, 255, 255, 0.22);
    border-top-color: var(--gold);
    border-radius: 50%;
    animation: spin 0.6s linear infinite;
    display: inline-block;
    box-sizing: border-box;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }
</style>

<script>
  import {
    validatePhone,
    formatPhone,
    validateCPF,
    formatCPF,
    isEmailFormatValid,
    completeEmailWithDomain,
  } from '../utils/validators';
  import { initAttribution, poloValue, cookieDomain } from '../scripts/attribution';
  import { track } from '../scripts/track';

  const modal = document.querySelector<HTMLElement>('[data-promoter-capture-modal]');

  if (modal) {
    const appUrl = modal.dataset.appUrl?.replace(/\/+$/, '') ?? 'https://app.supletivo.net.br';
    const backendUrl = modal.dataset.backendUrl?.replace(/\/+$/, '') ?? 'https://app.supletivo.net.br';

    // Inputs & Steps
    const stepPhone = modal.querySelector<HTMLElement>('#step-phone');
    const stepCpf = modal.querySelector<HTMLElement>('#step-cpf');
    const stepEmail = modal.querySelector<HTMLElement>('#step-email');
    const stepExisting = modal.querySelector<HTMLElement>('#step-existing');

    const inputPhone = modal.querySelector<HTMLInputElement>('#promoter-input-phone');
    const inputCpf = modal.querySelector<HTMLInputElement>('#promoter-input-cpf');
    const inputEmail = modal.querySelector<HTMLInputElement>('#promoter-input-email');

    const phoneWrapper = modal.querySelector<HTMLElement>('#phone-wrapper');
    const cpfWrapper = modal.querySelector<HTMLElement>('#cpf-wrapper');
    const emailWrapper = modal.querySelector<HTMLElement>('#email-wrapper');

    const breadcrumbs = modal.querySelector<HTMLElement>('#promoter-breadcrumbs');
    const chipPhone = modal.querySelector<HTMLButtonElement>('#chip-phone');
    const chipPhoneText = modal.querySelector<HTMLElement>('#chip-phone-text');
    const chipCpf = modal.querySelector<HTMLButtonElement>('#chip-cpf');
    const chipCpfText = modal.querySelector<HTMLElement>('#chip-cpf-text');

    const speech = modal.querySelector<HTMLElement>('#promoter-modal-title');

    // Visual Stage elements
    const promoterLed = modal.querySelector<HTMLElement>('#promoter-led');
    const promoterDocPreview = modal.querySelector<HTMLElement>('#promoter-doc-preview');
    const promoterStatusBadge = modal.querySelector<HTMLElement>('#promoter-status-badge');
    const promoterStatusText = modal.querySelector<HTMLElement>('#promoter-status-text');

    let isCheckingPhone = false;
    let isCheckingCpf = false;
    let isSubmitting = false;
    let lastCheckedPhone = '';
    let lastCheckedCpf = '';
    let emailDebounceTimer: ReturnType<typeof setTimeout> | null = null;
    let existingTimer: ReturnType<typeof setTimeout> | null = null;
    let existingInterval: ReturnType<typeof setInterval> | null = null;

    function clearTimers() {
      if (emailDebounceTimer) { clearTimeout(emailDebounceTimer); emailDebounceTimer = null; }
      if (existingTimer) { clearTimeout(existingTimer); existingTimer = null; }
      if (existingInterval) { clearInterval(existingInterval); existingInterval = null; }
    }

    // ── DRY HELPERS (PONYTAIL) ────────────────────────────────────────────────
    async function checkAuth(payload: Record<string, unknown>) {
      const attr = initAttribution();
      const polo = poloValue(attr);
      try {
        const res = await fetch(`${backendUrl}/api/v1/collaborators/auth/check`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            send_otp: true,
            hub: polo || undefined,
            ref: polo || undefined,
            ...payload,
          }),
          signal: AbortSignal.timeout(3500),
        });
        return res.ok ? await res.json() : null;
      } catch (err) {
        console.warn('[promoter-capture] Falha ou timeout no checkAuth:', err);
        return null;
      }
    }

    function saveSession(data: Record<string, unknown>) {
      const attr = initAttribution();
      const polo = poloValue(attr);
      const sessionPayload = JSON.stringify({
        ...data,
        role: 'promoter',
        hub: polo || undefined,
        ref: polo || undefined,
        ts: Date.now(),
      });
      const domainStr = cookieDomain();
      const isSecure = location.protocol === 'https:' ? ';Secure' : '';
      document.cookie = `supletivo.session=${encodeURIComponent(sessionPayload)}; path=/; max-age=1800; SameSite=Lax${domainStr}${isSecure}`;
    }

    function redirectToOtp(params: { id?: string; tel?: string; cpf?: string; email?: string }, delayMs = 0) {
      const attr = initAttribution();
      const polo = poloValue(attr);
      const targetUrl = new URL(`${appUrl}/autenticacao/otp`);
      if (params.id) targetUrl.searchParams.set('id', params.id);
      if (params.tel) targetUrl.searchParams.set('tel', params.tel);
      if (params.cpf) targetUrl.searchParams.set('cpf', params.cpf);
      if (params.email) targetUrl.searchParams.set('email', params.email);
      targetUrl.searchParams.set('role', 'promotor');
      if (polo) targetUrl.searchParams.set('ref', polo);

      if (delayMs > 0) {
        setTimeout(() => { window.location.href = targetUrl.toString(); }, delayMs);
      } else {
        window.location.href = targetUrl.toString();
      }
    }

    // Modal Visibility Controls
    function openModal() {
      clearTimers();
      modal.removeAttribute('hidden');
      modal.removeAttribute('inert');
      modal.setAttribute('aria-hidden', 'false');
      modal.classList.add('is-active');
      document.body.style.overflow = 'hidden';

      // Reset to Step 1
      isSubmitting = false;
      stepPhone?.classList.remove('hidden');
      stepCpf?.classList.add('hidden');
      stepEmail?.classList.add('hidden');
      stepExisting?.classList.add('hidden');
      breadcrumbs?.classList.add('hidden');

      if (speech) {
        speech.textContent = 'Olá! Para onde te envio seu link oficial de promotor e o kit de divulgação?';
      }

      setTimeout(() => { inputPhone?.focus(); }, 60);
      track('promoter_modal_opened', { timestamp: Date.now() });
    }

    function closeModal() {
      clearTimers();
      modal.classList.remove('is-active');
      modal.setAttribute('aria-hidden', 'true');
      modal.setAttribute('hidden', '');
      modal.setAttribute('inert', '');
      document.body.style.overflow = '';
      track('promoter_modal_closed', { timestamp: Date.now() });
    }

    modal.querySelectorAll('[data-close-modal]').forEach((el) => {
      el.addEventListener('click', closeModal);
    });

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.classList.contains('is-active')) closeModal();
    });

    (window as unknown as { openPromoterModal?: () => void }).openPromoterModal = openModal;

    // ── GESTÃO DA ETAPA 1: WHATSAPP (SUBMISSÃO IMEDIATA NO 11º DÍGITO) ────────
    async function checkAndSubmitPhone(digits: string) {
      if (isCheckingPhone || digits === lastCheckedPhone) return;
      lastCheckedPhone = digits;
      isCheckingPhone = true;

      phoneWrapper?.classList.add('loading');
      phoneWrapper?.classList.remove('valid');

      const data = await checkAuth({ phone: digits, contato: digits });
      phoneWrapper?.classList.remove('loading');
      isCheckingPhone = false;

      // Se promotor já existe: OTP enviado -> direto pro app (Zero-Button!)
      if (data?.found) {
        phoneWrapper?.classList.add('valid');
        promoterLed?.classList.add('verified');
        if (speech) {
          speech.textContent = 'Que bom ter você de volta! Localizamos seu cadastro de promotor e enviamos seu código no WhatsApp. Redirecionando...';
        }
        saveSession({ phone: digits });
        track('promoter_phone_existing', { phone: digits });
        redirectToOtp({ id: data.external_id, tel: digits }, 500);
        return;
      }

      // Novo promotor: avanço instantâneo para CPF
      phoneWrapper?.classList.add('valid');
      promoterLed?.classList.add('verified');
      advanceToCpfStep();
    }

    function handlePhoneInput() {
      if (!inputPhone) return;
      const digits = inputPhone.value.replace(/\D/g, '');
      inputPhone.value = formatPhone(digits);

      const isValid = validatePhone(digits);
      phoneWrapper?.classList.toggle('valid', isValid);

      if (isValid && digits.length === 11) {
        promoterLed?.classList.add('verified');
        if ('vibrate' in navigator) navigator.vibrate(12);
        checkAndSubmitPhone(digits);
      } else {
        lastCheckedPhone = '';
        promoterLed?.classList.remove('verified');
      }
    }

    function advanceToCpfStep() {
      if (!inputPhone || !validatePhone(inputPhone.value)) return;

      stepPhone?.classList.add('hidden');
      stepCpf?.classList.remove('hidden');
      stepEmail?.classList.add('hidden');
      stepExisting?.classList.add('hidden');

      if (breadcrumbs && chipPhoneText) {
        breadcrumbs.classList.remove('hidden');
        chipPhone?.classList.remove('hidden');
        chipPhoneText.textContent = inputPhone.value;
        chipCpf?.classList.add('hidden');
      }

      if (speech) {
        speech.textContent = 'Agora digite seu CPF para emissão do credenciamento e vinculação da sua chave Pix:';
      }

      setTimeout(() => { inputCpf?.focus(); }, 50);
    }

    inputPhone?.addEventListener('input', handlePhoneInput);

    // Breadcrumbs
    chipPhone?.addEventListener('click', () => {
      clearTimers();
      stepCpf?.classList.add('hidden');
      stepEmail?.classList.add('hidden');
      stepExisting?.classList.add('hidden');
      stepPhone?.classList.remove('hidden');
      breadcrumbs?.classList.add('hidden');
      if (speech) {
        speech.textContent = 'Olá! Para onde te envio seu link oficial de promotor e o kit de divulgação?';
      }
      inputPhone?.focus();
    });

    chipCpf?.addEventListener('click', () => {
      clearTimers();
      stepEmail?.classList.add('hidden');
      stepPhone?.classList.add('hidden');
      stepExisting?.classList.add('hidden');
      stepCpf?.classList.remove('hidden');
      chipCpf?.classList.add('hidden');
      if (speech) {
        speech.textContent = 'Agora digite seu CPF para emissão do credenciamento e vinculação da sua chave Pix:';
      }
      inputCpf?.focus();
    });

    // ── GESTÃO DA ETAPA 2: CPF (MÓDULO 11) ──────────────────────────────────
    async function checkAndSubmitCpf(digits: string) {
      if (isCheckingCpf || digits === lastCheckedCpf) return;
      lastCheckedCpf = digits;
      isCheckingCpf = true;

      cpfWrapper?.classList.add('loading');
      cpfWrapper?.classList.remove('valid');

      const phoneDigits = inputPhone?.value.replace(/\D/g, '') ?? '';
      const data = await checkAuth({ cpf: digits, phone: phoneDigits });
      cpfWrapper?.classList.remove('loading');
      isCheckingCpf = false;

      if (data?.found) {
        const cleanMasked = (data?.masked_phone || '').replace(/\D/g, '');
        const isDifferentPhone = Boolean(
          cleanMasked &&
          cleanMasked.length >= 4 &&
          phoneDigits.length >= 4 &&
          !phoneDigits.endsWith(cleanMasked.slice(-4)) &&
          !cleanMasked.endsWith(phoneDigits.slice(-4))
        );

        if (isDifferentPhone) {
          showExistingCard(data, digits, phoneDigits);
          return;
        }

        redirectToOtp({ id: data.external_id, tel: phoneDigits, cpf: digits });
        return;
      }

      // CPF novo: atualiza credencial e avança
      cpfWrapper?.classList.add('valid');
      if (promoterDocPreview) promoterDocPreview.textContent = `CPF: ${formatCPF(digits)}`;
      promoterStatusBadge?.classList.add('authorized');
      if (promoterStatusText) promoterStatusText.textContent = 'CREDENCIAL AUTORIZADA';
      if ('vibrate' in navigator) navigator.vibrate(15);

      advanceToEmailStep();
    }

    function showExistingCard(data: any, cpfDigits: string, phoneDigits: string) {
      clearTimers();
      stepPhone?.classList.add('hidden');
      stepCpf?.classList.add('hidden');
      stepEmail?.classList.add('hidden');
      stepExisting?.classList.remove('hidden');

      const existingPhoneMasked = modal.querySelector<HTMLElement>('#existing-phone-masked');
      if (existingPhoneMasked && data.masked_phone) {
        existingPhoneMasked.textContent = data.masked_phone;
      }
      if (speech) {
        speech.textContent = 'Identificamos que seu CPF já possui credencial de promotor vinculada.';
      }

      const attr = initAttribution();
      const polo = poloValue(attr);
      const targetUrl = new URL(`${appUrl}/autenticacao/otp`);
      if (data.external_id) targetUrl.searchParams.set('id', data.external_id);
      targetUrl.searchParams.set('tel', phoneDigits);
      targetUrl.searchParams.set('cpf', cpfDigits);
      targetUrl.searchParams.set('role', 'promotor');
      if (polo) targetUrl.searchParams.set('ref', polo);

      const existingLink = modal.querySelector<HTMLAnchorElement>('#btn-existing-redirect');
      if (existingLink) {
        existingLink.href = targetUrl.toString();
      }

      const progressBar = modal.querySelector<HTMLElement>('#existing-progress-bar');
      if (progressBar) {
        progressBar.style.transition = 'none';
        progressBar.style.transform = 'scaleX(1)';
        void progressBar.offsetWidth;
        progressBar.style.transition = 'transform 2.8s linear';
        progressBar.style.transform = 'scaleX(0)';
      }

      let seconds = 3;
      const countdownEl = modal.querySelector<HTMLElement>('#existing-countdown');
      if (countdownEl) countdownEl.textContent = String(seconds);

      existingInterval = setInterval(() => {
        seconds -= 1;
        if (countdownEl && seconds >= 0) countdownEl.textContent = String(seconds);
      }, 1000);

      existingTimer = setTimeout(() => {
        window.location.href = targetUrl.toString();
      }, 2900);
    }

    function handleCpfInput() {
      if (!inputCpf) return;
      const digits = inputCpf.value.replace(/\D/g, '');
      inputCpf.value = formatCPF(digits);

      const isValid = validateCPF(digits);
      cpfWrapper?.classList.toggle('valid', isValid);

      if (isValid && digits.length === 11) {
        checkAndSubmitCpf(digits);
      } else {
        lastCheckedCpf = '';
        if (promoterDocPreview) promoterDocPreview.textContent = 'DOCUMENTAÇÃO PENDENTE';
        promoterStatusBadge?.classList.remove('authorized');
        if (promoterStatusText) promoterStatusText.textContent = 'CONTATO CONFIRMADO';
      }
    }

    function advanceToEmailStep() {
      if (!inputCpf || !validateCPF(inputCpf.value)) return;

      stepPhone?.classList.add('hidden');
      stepCpf?.classList.add('hidden');
      stepEmail?.classList.remove('hidden');
      stepExisting?.classList.add('hidden');

      if (breadcrumbs && chipCpf && chipCpfText) {
        breadcrumbs.classList.remove('hidden');
        chipCpf.classList.remove('hidden');
        chipCpfText.textContent = inputCpf.value;
      }

      if (speech) {
        speech.textContent = 'Qual o seu melhor e-mail para receber os acessos do painel e materiais de vendas?';
      }

      setTimeout(() => { inputEmail?.focus(); }, 50);
    }

    inputCpf?.addEventListener('input', handleCpfInput);

    // ── GESTÃO DA ETAPA 3: E-MAIL ───────────────────────────────────────────
    function handleEmailInput() {
      if (!inputEmail) return;
      const val = inputEmail.value.trim();
      const isValid = isEmailFormatValid(val);
      emailWrapper?.classList.toggle('valid', isValid);

      if (emailDebounceTimer) { clearTimeout(emailDebounceTimer); emailDebounceTimer = null; }

      if (isValid && !isSubmitting) {
        emailDebounceTimer = setTimeout(() => {
          if (isEmailFormatValid(inputEmail.value.trim())) submitPromoterLeadCapture();
        }, 350);
      }
    }

    inputEmail?.addEventListener('input', handleEmailInput);
    inputEmail?.addEventListener('blur', () => {
      if (inputEmail && isEmailFormatValid(inputEmail.value.trim()) && !isSubmitting) {
        submitPromoterLeadCapture();
      }
    });

    modal.querySelectorAll<HTMLButtonElement>('.domain-chip').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (!inputEmail) return;
        const domain = btn.dataset.domain;
        if (domain) {
          inputEmail.value = completeEmailWithDomain(inputEmail.value, domain);
          handleEmailInput();
          if (isEmailFormatValid(inputEmail.value.trim())) submitPromoterLeadCapture();
        }
      });
    });

    modal.querySelector('#promoter-capture-form')?.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!stepPhone?.classList.contains('hidden')) {
        const digits = inputPhone?.value.replace(/\D/g, '') ?? '';
        if (validatePhone(digits)) checkAndSubmitPhone(digits);
        return;
      }
      if (!stepCpf?.classList.contains('hidden')) {
        const digits = inputCpf?.value.replace(/\D/g, '') ?? '';
        if (validateCPF(digits)) checkAndSubmitCpf(digits);
        return;
      }
      if (!stepEmail?.classList.contains('hidden')) {
        if (inputEmail && isEmailFormatValid(inputEmail.value.trim())) submitPromoterLeadCapture();
      }
    });

    // ── SUBMISSÃO FINAL E HANDOFF (AS 3 VALIDAÇÕES CONFIRMADAS) ───────────────
    async function submitPromoterLeadCapture() {
      if (isSubmitting) return;

      const phoneDigits = inputPhone?.value.replace(/\D/g, '') ?? '';
      const cpfDigits = inputCpf?.value.replace(/\D/g, '') ?? '';
      const emailValue = inputEmail?.value.trim() ?? '';

      if (!validatePhone(phoneDigits)) { chipPhone?.click(); return; }
      if (!validateCPF(cpfDigits)) { chipCpf?.click(); return; }
      if (!isEmailFormatValid(emailValue)) { inputEmail?.focus(); return; }

      isSubmitting = true;
      emailWrapper?.classList.add('loading');
      emailWrapper?.classList.remove('valid');

      if ('vibrate' in navigator) navigator.vibrate([15, 35, 15]);

      saveSession({ phone: phoneDigits, cpf: cpfDigits, email: emailValue });
      track('promoter_capture_submitted', { has_cpf: true, has_email: true });

      const data = await checkAuth({
        contato: phoneDigits,
        phone: phoneDigits,
        cpf: cpfDigits,
        email: emailValue,
      });

      emailWrapper?.classList.remove('loading');
      emailWrapper?.classList.add('valid');

      redirectToOtp({
        id: data?.external_id,
        tel: phoneDigits,
        cpf: cpfDigits,
        email: emailValue,
      }, 250);
    }

    // Auto-abertura inteligente se o usuário chega direcionado com tel ou modal=cadastro
    const urlParams = new URLSearchParams(window.location.search);
    const telParam = urlParams.get('tel');
    const modalParam = urlParams.get('modal');
    if (telParam || modalParam === 'cadastro') {
      openModal('app_redirect');
      if (telParam && inputPhone) {
        const cleanDigits = telParam.replace(/\D/g, '');
        if (cleanDigits.length >= 10) {
          inputPhone.value = formatPhone(cleanDigits);
          handlePhoneInput();
        }
      }
    }
  }
</script>
