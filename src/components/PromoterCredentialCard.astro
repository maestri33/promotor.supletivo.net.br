---
/**
 * PromoterCredentialCard.astro - The Promoter Credential Stage (3D Holográfico)
 * Identidade visual da credencial oficial do promotor/consultor regional com chip dourado.
 */
interface Props {
  promoterName?: string;
  promoterDoc?: string;
  statusText?: string;
  sealText?: string;
  className?: string;
}

const {
  promoterName = 'CONSULTOR AUTORIZADO',
  promoterDoc = 'DOCUMENTAÇÃO PENDENTE',
  statusText = 'AGUARDANDO CONTATO',
  sealText = 'POLO OFICIAL',
  className = '',
} = Astro.props;
---

<div class={`credential-stage-wrapper ${className}`}>
  <div class="promoter-card-3d spatial-card-3d" id="promoter-card-visual" data-tilt-3d data-tilt-max="12">
    <div class="card-gold-sheen" aria-hidden="true"></div>
    <div class="card-top">
      <div class="card-header-badge">
        <span class="card-star">★</span>
        <span class="card-title">CREDENCIAL OFICIAL DE PROMOTOR</span>
      </div>
      <div class="chip-hologram">
        <div class="chip-lines"></div>
        <span class="chip-led" id="promoter-led"></span>
      </div>
    </div>

    <div class="card-center">
      <div class="card-label">CONSULTOR REGIONAL</div>
      <div class="card-promoter-name" id="promoter-name-preview">{promoterName}</div>
      <div class="card-doc" id="promoter-doc-preview">{promoterDoc}</div>
    </div>

    <div class="card-bottom">
      <div class="card-status-badge" id="promoter-status-badge">
        <span class="status-dot"></span>
        <span id="promoter-status-text">{statusText}</span>
      </div>
      <div class="card-seal">{sealText}</div>
    </div>

    <!-- Filete Dourado Decorativo -->
    <div class="card-gold-strip" aria-hidden="true"></div>
  </div>
</div>

<style>
  .credential-stage-wrapper {
    perspective: 1000px;
    width: 100%;
    max-width: 320px;
  }

  .promoter-card-3d {
    position: relative;
    aspect-ratio: 1.586;
    background: linear-gradient(145deg, var(--char-2) 0%, var(--black) 100%);
    border: 1.5px solid color-mix(in srgb, var(--gold) 45%, transparent);
    border-radius: 18px;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: 0 20px 45px -10px rgba(0, 0, 0, 0.6), 0 0 20px -2px color-mix(in srgb, var(--gold) 15%, transparent);
    overflow: hidden;
  }

  .card-gold-sheen {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.12) 0%, transparent 60%);
    pointer-events: none;
  }

  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .card-header-badge {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .card-star {
    color: var(--gold);
    font-size: 0.8rem;
  }

  .card-title {
    font-size: 0.64rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    color: var(--gold-soft);
    text-transform: uppercase;
  }

  .chip-hologram {
    position: relative;
    width: 34px;
    height: 26px;
    border-radius: 4px;
    background: linear-gradient(135deg, var(--gold-soft) 0%, var(--gold) 50%, var(--gold-deep) 100%);
    box-shadow: inset 0 0 4px rgba(0, 0, 0, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .chip-lines {
    width: 70%;
    height: 60%;
    border: 1px solid rgba(0, 0, 0, 0.4);
    border-radius: 2px;
  }

  .chip-led {
    position: absolute;
    top: 2px;
    right: 2px;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--gold);
    box-shadow: 0 0 4px var(--gold);
    transition: background 0.3s;
  }

  :global(.chip-led.verified) {
    background: var(--success);
    box-shadow: 0 0 6px var(--success);
  }

  .card-center {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .card-label {
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--gold);
    text-transform: uppercase;
  }

  .card-promoter-name {
    font-family: var(--font-display, 'Archivo Black', sans-serif);
    font-size: 0.95rem;
    color: var(--paper);
    line-height: 1.1;
    letter-spacing: 0.02em;
  }

  .card-doc {
    font-size: 0.72rem;
    color: var(--muted-on-dark);
    font-family: monospace;
  }

  .card-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .card-status-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    font-size: 0.64rem;
    font-weight: 700;
    color: var(--muted-on-dark);
    text-transform: uppercase;
  }

  :global(.card-status-badge.authorized) {
    background: color-mix(in srgb, var(--success) 20%, transparent);
    border-color: var(--success);
    color: var(--success-bg, #dcfce7);
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--gold);
  }

  :global(.card-status-badge.authorized) .status-dot {
    background: var(--success);
    box-shadow: 0 0 6px var(--success);
  }

  .card-seal {
    font-size: 0.65rem;
    font-weight: 800;
    color: var(--gold);
    letter-spacing: 0.05em;
  }

  .card-gold-strip {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: var(--gold-grad);
  }
</style>
